            お知らせ一覧を見る
          </a>
        </div>
      </section>
      <!-- Locationセクション -->
    <!-- Locationセクション -->
    <section id="location" class="px-4 py-16 max-w-4xl mx-auto">
      <div class="space-y-8">
        <!-- 見出し -->
        <div class="flex items-center gap-3">
          <div class="w-1 h-6" style="background-color: #FFED00;"></div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white tracking-wide">Location</h2>

            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
        </div>
      </div>
    </section>
    <!-- 体験予約・お問い合わせフォーム（Googleフォーム埋め込み） -->
    <section id="booking" class="px-4 py-16 max-w-4xl mx-auto">
      <div class="bg-zinc-900/80 border border-zinc-800 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6">
        
        <!-- 見出し -->
        <div class="flex items-center gap-3">
          <div class="w-1 h-6" style="background-color: #FFED00;"></div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white tracking-wide">体験予約</h2>
        </div>

        <!-- Googleフォーム埋め込みエリア -->
        <div class="w-full overflow-hidden rounded-2xl bg-white/5 border border-zinc-800">
          <iframe 
            src="https://docs.google.com/forms/d/e/1FAIpQLSdm-5NcfI_gbX2yNTgL5oD78KbidNWTWL9UYs2-0nAoHS3FxA/viewform?embedded=true" 
            class="w-full h-[750px] sm:h-[850px] border-0" 
            loading="lazy">
            読み込み中...
          </iframe>
        </div>
<!-- プライバシーポリシーへの誘導テキストの例 -->
<div class="text-center mt-4">
  <p class="text-xs text-zinc-400">
    ご入力いただいた情報は、<a href="/privacy" target="_blank" class="text-zinc-300 underline hover:text-white">プライバシーポリシー</a>をご確認の上、ご同意いただいてから送信してください。
  </p>
</div>
      </div>
    </section>
    </div>
</main>
</Layout>

---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja" class="bg-[#1E1E1E]">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body class="bg-[#1E1E1E] text-white font-sans min-h-screen flex flex-col m-0 p-0">
    
    <!-- 共通ヘッダー -->
    <Header />

    <!-- メインコンテンツ（FeatureやFacilityなどの全コンテンツがここに入ります） -->
    <div class="flex-1 w-full">
      <slot />
    </div>

    <!-- 共通フッター -->
    <Footer />

    <style is:global>
      @import "tailwindcss";
    </style>
  </body>
</html>

